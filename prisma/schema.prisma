/* ============================================================
   علَّمني تِك — Alemny Tech — Production Schema
   Provider: Neon PostgreSQL  |  ORM: Prisma
   All Arabic content collections of the platform live here.
   ============================================================ */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ------------------------------------------------------------
   مكتبة البرومبتات السحرية — Magic Prompt Vault
   ------------------------------------------------------------ */
model Prompt {
  id           String   @id @default(cuid())
  slug         String   @unique // stable key, e.g. "master-mentor"
  title        String
  category     String // study | coding | design | productivity
  targetModel  String // primary model shown on the badge
  targetModels Json // full badge list (string[])
  resultHook   String // the "what you get" hook line
  promptText   String   @db.Text // the full engineered prompt body
  variables    Json // [{ key, label, placeholder }]
  icon         String // UI icon key
  tips         Json // string[] pro tips
  keywords     Json // string[] search keywords (ar/en)
  ltr          Boolean  @default(false) // LTR rendering for latin-heavy prompts
  copiesCount  Int      @default(0) // incremented on every «نسخ البرومبت»
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([copiesCount])
}

/* ------------------------------------------------------------
   دليل أدوات الذكاء الاصطناعي ٢٠٢٦ — AI Tools Directory
   ------------------------------------------------------------ */
model AiTool {
  id          String   @id @default(cuid())
  slug        String   @unique // stable key, e.g. "notebooklm"
  name        String // English display name ("Gemini Notebook")
  arabicTitle String // Arabic annotation
  category    String // study | coding | design | media
  pricingType String // free | freemium
  description String   @db.Text // tagline
  officialUrl String // verified official link
  badge       String? // highlight badge ("الأقوى للمذاكرة")
  features    Json // string[] feature list
  useCase     String   @db.Text // recommended workflow
  icon        String // UI icon key
  keywords    Json // string[] search keywords
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([pricingType])
}

/* ------------------------------------------------------------
   حلبة المواجهة Versus — Gemini vs Claude 5.5 vs ChatGPT
   ------------------------------------------------------------ */
model VersusMission {
  id              String   @id @default(cuid())
  slug            String   @unique // stable key, e.g. "study"
  number          String // Arabic-Indic ordinal ("١")
  title           String
  shortTitle      String
  icon            String // book | code | pen | mic
  description     String   @db.Text
  scenario        String   @db.Text // the real-world test scenario
  geminiScore     Int // 0-100
  claudeScore     Int
  chatgptScore    Int
  winner          String // gemini | claude | chatgpt
  summary         String   @db.Text // the verdict
  challengePrompt String   @db.Text // unified challenge prompt (copy-ready)
  workflow        Json // string[] recommended workflow steps
  models          Json // full scorecards: [{ id, score, pros[], cons[] }]
  keywords        Json // string[] search keywords
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([winner])
}

/* ------------------------------------------------------------
   المقالات والأخبار التقنية — Evergreen Tech Articles
   ------------------------------------------------------------ */
model Article {
  id          String   @id @default(cuid())
  slug        String   @unique // stable key, e.g. "ai-agents-2026"
  title       String
  excerpt     String   @db.Text // the deck / subtitle
  category    String // ai | dev | security | future
  readMinutes Int      @default(5)
  tags        Json // string[]
  content     String   @db.Text // full article body (## headings, - bullets, paragraphs)
  keywords    Json // string[] search keywords
  published   Boolean  @default(true)
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([published])
  @@index([featured])
}

/* ------------------------------------------------------------
   إشعارات الويب الفورية — Web Push Subscriptions (VAPID)
   visitor = متابعو المنصة العامة | admin = أجهزة التنبيهات الأمنية
   ------------------------------------------------------------ */
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  role      String   @default("visitor") // visitor | admin
  createdAt DateTime @default(now())

  @@index([role])
}

/* ------------------------------------------------------------
   جداول بوابة الإدارة السيادية (alemny-tech-admin)
   نفس قاعدة Neon — تُدار من التطبيق المنفصل، وموجودة هنا
   حتى لا يحذفها أي db push من هذا المشروع أبدًا.
   ------------------------------------------------------------ */
model AdminSecurityConfig {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  totpSecret         String    @default("") // base32, RFC 6238
  totpEnabled        Boolean   @default(false)
  activeSessionToken String    @default("") // single-device lock
  activeDeviceHash   String    @default("") // sha256(userAgent + ip)
  lastLoginAt        DateTime?
  lastSeenAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model AdminLoginLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  ip         String   @default("")
  userAgent  String   @default("")
  deviceType String   @default("unknown") // mobile | tablet | desktop | bot | unknown
  status     String // SUCCESS | FAILED_PASSWORD | FAILED_2FA | BLOCKED_ATTEMPT | LOGOUT
  reason     String   @default("")

  @@index([timestamp])
  @@index([status])
}

model BlockedIp {
  id             String    @id @default(cuid())
  ip             String    @unique
  failedAttempts Int       @default(0)
  blockedUntil   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/* ------------------------------------------------------------
   أكاديمية الشروحات العملية — Tutorials Hub
   ------------------------------------------------------------ */
model Tutorial {
  id         String   @id @default(cuid())
  slug       String   @unique // stable key, e.g. "notebook-mastery"
  title      String
  summary    String   @db.Text // subtitle
  level      String // مبتدئ | متوسط | مبتدئ → متوسط
  duration   String // "١٢ دقيقة"
  icon       String // notebook | cursor | veo
  steps      Json // [{ title, desc, tip }]
  youtubeUrl String // official channel / walkthrough link
  keywords   Json // string[] search keywords
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
